+++ b/artifact_copy.py
@@ -0,0 +1,47 @@
+"""Copy untrusted static output without ever following host-side symlinks."""
+import os
+import shutil
+import stat
+from pathlib import Path
+
+
+def copy_artifacts(source: Path, destination: Path) -> None:
+    """Accept regular files/directories only, resolving each child relative to an open fd.
+
+    A build can leave absolute links in dist. copytree's default dereferences those
+    links on the host, outside the sandbox. O_NOFOLLOW also prevents swap races.
+    """
+    def copy_directory(source_fd: int, target: Path) -> None:
+        target.mkdir()
+        with os.scandir(source_fd) as entries:
+            for entry in entries:
+                mode = entry.stat(follow_symlinks=False).st_mode
+                if not (stat.S_ISDIR(mode) or stat.S_ISREG(mode)):
+                    raise ValueError('build output contains a symlink or special file')
+                flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+                if stat.S_ISDIR(mode):
+                    flags |= os.O_DIRECTORY
+                child_fd = os.open(entry.name, flags, dir_fd=source_fd)
+                try:
+                    actual = os.fstat(child_fd).st_mode
+                    if stat.S_ISDIR(actual):
+                        copy_directory(child_fd, target / entry.name)
+                    elif stat.S_ISREG(actual):
+                        with os.fdopen(os.dup(child_fd), 'rb') as stream:
+                            with (target / entry.name).open('xb') as output:
+                                shutil.copyfileobj(stream, output)
+                    else:
+                        raise ValueError('build output contains a special file')
+                finally:
+                    os.close(child_fd)
+
+    if source.is_symlink():
+        raise ValueError('build output contains a symlink')
+    source_fd = os.open(source, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        copy_directory(source_fd, destination)
+    except Exception:
+        shutil.rmtree(destination, ignore_errors=True)
+        raise
+    finally:
+        os.close(source_fd)
