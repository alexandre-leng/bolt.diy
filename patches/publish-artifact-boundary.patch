@@ -0,0 +1,57 @@
+"""Untrusted build output must never cause host-side symlink dereferences."""
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from artifact_copy import copy_artifacts
+import bolt_publish as bp
+import private_preview as pp
+
+
+class ArtifactBoundaryTests(unittest.TestCase):
+    def test_copies_nested_regular_files_byte_for_byte(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            source = root / 'dist'
+            (source / 'assets').mkdir(parents=True)
+            data = bytes(range(256))
+            (source / 'assets' / 'image.bin').write_bytes(data)
+            copy_artifacts(source, root / 'published')
+            self.assertEqual((root / 'published' / 'assets' / 'image.bin').read_bytes(), data)
+
+    def test_publish_rejects_symlink_to_host_file_before_copying(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            src = root / 'site' / 'src-files'
+            (src / 'node_modules' / '.bin').mkdir(parents=True)
+            (src / 'node_modules' / '.bin' / 'vite').touch()
+            (src / 'package.json').write_text('{}')
+            (src / 'dist').mkdir()
+            marker = root / 'host-private.txt'
+            marker.write_text('LOCAL_TEST_MARKER')
+            (src / 'dist' / 'index.html').write_text('<html>safe</html>')
+            (src / 'dist' / 'leaked.txt').symlink_to(marker)
+            with patch.object(bp, 'SITES_ROOT', root), patch.object(bp, 'run', return_value=(0, '')):
+                with self.assertRaisesRegex(ValueError, 'symlink'):
+                    bp.build_site('site')
+            self.assertFalse((root / 'site' / 'public' / 'leaked.txt').exists())
+
+    def test_preview_rejects_symlinked_dist_directory(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            outside = root / 'host-data'
+            outside.mkdir()
+            (outside / 'index.html').write_text('LOCAL_TEST_MARKER')
+
+            def build(work):
+                (work / 'dist').symlink_to(outside, target_is_directory=True)
+                return True, ''
+
+            with patch.object(pp, 'PREVIEW_ROOT', root), patch.object(pp, '_build_with_vite', side_effect=build):
+                with self.assertRaisesRegex(ValueError, 'symlink'):
+                    pp._build_preview_locked({'index.html': '<html>test</html>'}, True)
+
+
+if __name__ == '__main__':
+    unittest.main()
