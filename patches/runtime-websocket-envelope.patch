+import type { RequestMessage } from './protocol.js';
+
+/** Validate the envelope before any property access outside the handler's error boundary. */
+export function isRequestMessage(value: unknown): value is RequestMessage {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return false;
+  }
+
+  const message = value as Record<string, unknown>;
+  return typeof message.id === 'number' && Number.isFinite(message.id) && typeof message.op === 'string';
+}
